PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DATABASE=project2
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Firebase/Firestore shared project
FIREBASE_PROJECT_ID=micro-eye-508217-q3
FIRESTORE_DATABASE_ID=(default)

# Choose bhushan or ryan for local development.
FIREBASE_CREDENTIAL_PROFILE=bhushan
FIREBASE_CREDENTIALS_BHUSHAN=./credentials/bhushannakhate-service-account.json
FIREBASE_CREDENTIALS_RYAN=./credentials/ryan-service-account.json
FIREBASE_AUTH_EMULATOR_HOST=

# Production: set to a Google service-account secret file mounted by Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=
