PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DEMO_CUSTOMERS_ENABLED=false
# Required only when DEMO_CUSTOMERS_ENABLED=true.
MONGODB_URI=
MONGODB_DATABASE=project2

# Firebase/Firestore shared project
FIREBASE_PROJECT_ID=project-2-pinboard-2026
FIRESTORE_DATABASE_ID=(default)
MEDIA_STORAGE_BUCKET=project-2-pinboard-2026-media

# Choose bhushan or ryan for local development.
FIREBASE_CREDENTIAL_PROFILE=bhushan
FIREBASE_CREDENTIALS_BHUSHAN=./credentials/bhushannakhate-project-2-service-account.json
FIREBASE_CREDENTIALS_RYAN=./credentials/ryan-project-2-service-account.json
FIREBASE_AUTH_EMULATOR_HOST=

# Comma-separated, server-only allowlist of verified Firebase administrator emails.
ADMIN_EMAILS=

# Production: set to a Google service-account secret file mounted by Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Photos Picker OAuth. Keep the client secret and encryption key in Secret Manager in production.
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:4000/api/google-photos/oauth/callback
GOOGLE_PHOTOS_TOKEN_ENCRYPTION_KEY=
