{
  "name": "project-2-customer-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:demo": "node scripts/seedDemoCustomers.js",
    "lint": "eslint src test scripts eslint.config.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" package.json eslint.config.js README.md",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" package.json eslint.config.js README.md",
    "test": "node --test",
    "test:integration": "npx --yes firebase-tools@15.35.0 emulators:exec --only auth,firestore --project demo-project-2 \"node --test test/firestore.integration.test.js\"",
    "check": "npm run lint && npm run format:check && npm test",
    "firebase:check": "node scripts/checkFirebaseConfig.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mongodb": "^6.18.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
